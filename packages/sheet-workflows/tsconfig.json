{
  "extends": "../../tsconfig.browser.json",
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules", "dist", ".output", ".ts-out"],
  "compilerOptions": {
    "outDir": "./.ts-out",
    "rootDir": ".",
    "tsBuildInfoFile": "./.ts-out/.tsbuildinfo",
    "verbatimModuleSyntax": true,
    "paths": {
      "*": ["./*"],
      "~~/*": ["./*"],
      "@@/*": ["./*"],
      "~/*": ["./src/*"],
      "@/*": ["./src/*"],
      "effect-zero-workflow": ["../effect-zero-workflow/src/index.ts"],
      "effect-zero-workflow/*": ["../effect-zero-workflow/src/*"],
      "sheet-auth": ["../sheet-auth/src/index.ts"],
      "sheet-auth/*": ["../sheet-auth/src/*"],
      "sheet-bot-api": ["../sheet-bot-api/src/index.ts"],
      "sheet-bot-api/*": ["../sheet-bot-api/src/*"],
      "sheet-db-schema": ["../sheet-db-schema/src/schema.ts"],
      "sheet-db-schema/*": ["../sheet-db-schema/src/*"],
      "sheet-ingress-api": ["../sheet-ingress-api/src/index.ts"],
      "sheet-ingress-api/*": ["../sheet-ingress-api/src/*"],
      "sheet-message-content": ["../sheet-message-content/src/index.ts"],
      "sheet-message-content/*": ["../sheet-message-content/src/*"],
      "sheet-workflow-contracts": ["../sheet-workflow-contracts/src/index.ts"],
      "sheet-workflow-contracts/*": ["../sheet-workflow-contracts/src/*"],
      "sheet-zero-server": ["../sheet-zero-server/src/index.ts"],
      "sheet-zero-server/*": ["../sheet-zero-server/src/*"],
      "typhoon-core": ["../typhoon-core/src/index.ts"],
      "typhoon-core/*": ["../typhoon-core/src/*"],
      "typhoon-zero": ["../typhoon-zero/src/index.ts"],
      "typhoon-zero/*": ["../typhoon-zero/src/*"]
    }
  },
  "references": [
    {
      "path": "../effect-zero-workflow"
    },
    {
      "path": "../sheet-auth"
    },
    {
      "path": "../sheet-bot-api"
    },
    {
      "path": "../sheet-db-schema"
    },
    {
      "path": "../sheet-ingress-api"
    },
    {
      "path": "../sheet-message-content"
    },
    {
      "path": "../sheet-workflow-contracts"
    },
    {
      "path": "../sheet-zero-server"
    },
    {
      "path": "../typhoon-core"
    },
    {
      "path": "../typhoon-zero"
    },
    {
      "path": "../tooling-config"
    }
  ]
}
