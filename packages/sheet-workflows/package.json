{
  "name": "sheet-workflows",
  "version": "0.0.0",
  "private": true,
  "keywords": [],
  "author": "",
  "files": [
    "./dist/**"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./runner-source": {
      "types": "./src/runner/stagedSourceSupervisor.ts",
      "development": "./src/runner/stagedSourceSupervisor.ts",
      "default": "./dist/runner-source.mjs"
    },
    "./catalog-identity": {
      "types": "./src/catalogIdentity.d.mts",
      "development": "./src/catalogIdentity.ts",
      "default": "./dist/catalog-identity.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "vp fmt --check",
    "format:apply": "vp fmt",
    "lint": "vp lint src",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:browser-smoke": "node ./browser-runner-smoke.mjs",
    "build": "vp pack && tar -acf dist.tar.zst ./dist"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:",
    "@googleapis/sheets": "^10.0.1",
    "@opentelemetry/exporter-prometheus": "^0.207.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.207.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "effect": "catalog:",
    "effect-zero-workflow": "workspace:*",
    "google-auth-library": "^10.5.0",
    "playwright": "1.58.2",
    "sheet-auth": "workspace:*",
    "sheet-bot-api": "workspace:*",
    "sheet-domain": "workspace:*",
    "sheet-message-content": "workspace:*",
    "sheet-workflow-contracts": "workspace:*",
    "sheet-zero-server": "workspace:*",
    "typhoon-core": "workspace:*",
    "typhoon-zero": "workspace:*"
  },
  "devDependencies": {
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "tooling-config": "workspace:*",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:"
  }
}
