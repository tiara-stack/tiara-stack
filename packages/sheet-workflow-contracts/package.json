{
  "name": "sheet-workflow-contracts",
  "version": "0.0.0",
  "private": true,
  "files": [
    "./dist/**"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./catalog": {
      "types": "./dist/catalog.d.mts",
      "development": "./src/catalog.ts",
      "default": "./dist/catalog.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "development": "./src/client.ts",
      "default": "./dist/client.mjs"
    },
    "./failures": {
      "types": "./dist/failures.d.mts",
      "development": "./src/failures.ts",
      "default": "./dist/failures.mjs"
    },
    "./policy": {
      "types": "./dist/policy.d.mts",
      "development": "./src/policy.ts",
      "default": "./dist/policy.mjs"
    },
    "./values": {
      "types": "./dist/values.d.mts",
      "development": "./src/values.ts",
      "default": "./dist/values.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "vp fmt --check",
    "format:apply": "vp fmt",
    "lint": "vp lint src",
    "test": "vp test run",
    "test:watch": "vp test",
    "build": "vp pack && tsgo -b tsconfig.json --emitDeclarationOnly --force"
  },
  "dependencies": {
    "effect-zero-workflow": "workspace:*",
    "sheet-bot-api": "workspace:*",
    "sheet-domain": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "tooling-config": "workspace:*",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
