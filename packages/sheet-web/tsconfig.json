{
  "extends": "../../tsconfig.browser.json",
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", ".source/**/*.ts"],
  "exclude": ["node_modules", "dist", ".output", ".ts-out"],
  "compilerOptions": {
    "outDir": "./.ts-out",
    "rootDir": ".",
    "tsBuildInfoFile": "./.ts-out/.tsbuildinfo",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "types": ["vite/client", "react/canary"],
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "sheet-auth": ["../sheet-auth/src/index.ts"],
      "sheet-auth/*": ["../sheet-auth/src/*"],
      "sheet-bot-api": ["../sheet-bot-api/src/index.ts"],
      "sheet-bot-api/*": ["../sheet-bot-api/src/*"],
      "sheet-workflow-contracts": ["../sheet-workflow-contracts/src/index.ts"],
      "sheet-workflow-contracts/*": ["../sheet-workflow-contracts/src/*"],
      "sheet-zero-api": ["../sheet-zero-api/src/index.ts"],
      "sheet-zero-api/*": ["../sheet-zero-api/src/*"],
      "effect-zero-workflow": ["../effect-zero-workflow/src/index.ts"],
      "effect-zero-workflow/contract": ["../effect-zero-workflow/src/contract.ts"],
      "effect-zero-workflow/contract/zero": ["../effect-zero-workflow/src/contract-zero.ts"],
      "effect-zero-workflow/contract/transport": [
        "../effect-zero-workflow/src/contract-transport.ts"
      ],
      "effect-zero-workflow/*": ["../effect-zero-workflow/src/*"],
      "start-atom": ["../start-atom/src/index.ts"],
      "typhoon-core": ["../typhoon-core/src/index.ts"],
      "typhoon-core/*": ["../typhoon-core/src/*"],
      "typhoon-zero": ["../typhoon-zero/src/index.ts"],
      "typhoon-zero/*": ["../typhoon-zero/src/*"],
      "#/*": ["./src/*"],
      "collections/*": ["./.source/*"]
    }
  },
  "references": [
    {
      "path": "../sheet-auth"
    },
    {
      "path": "../sheet-bot-api"
    },
    {
      "path": "../sheet-workflow-contracts"
    },
    {
      "path": "../sheet-zero-api"
    },
    {
      "path": "../effect-zero-workflow"
    },
    {
      "path": "../start-atom"
    },
    {
      "path": "../typhoon-core"
    },
    {
      "path": "../typhoon-zero"
    },
    {
      "path": "../tooling-config"
    }
  ]
}
