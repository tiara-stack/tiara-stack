{
  "extends": "../../tsconfig.browser.json",
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules", "dist", ".output", ".ts-out"],
  "compilerOptions": {
    "outDir": "./.ts-out",
    "rootDir": ".",
    "tsBuildInfoFile": "./.ts-out/.tsbuildinfo",
    "paths": {
      "*": ["./*"],
      "~~/*": ["./*"],
      "@@/*": ["./*"],
      "effect-sql-kit": ["../effect-sql-kit/src/index.ts"],
      "effect-sql-schema": ["../effect-sql-schema/src/index.mts"],
      "effect-sql-schema/*": ["../effect-sql-schema/src/*"],
      "effect-zero": ["../effect-zero/src/index.ts"],
      "effect-zero/*": ["../effect-zero/src/*"],
      "effect-zero-workflow": ["../effect-zero-workflow/src/index.ts"],
      "sheet-domain": ["../sheet-domain/src/index.ts"],
      "sheet-zero-api": ["../sheet-zero-api/src/index.ts"],
      "sheet-zero-api/*": ["../sheet-zero-api/src/*"],
      "typhoon-zero": ["../typhoon-zero/src/index.ts"],
      "typhoon-zero/*": ["../typhoon-zero/src/*"]
    }
  },
  "references": [
    {
      "path": "../effect-sql-kit"
    },
    {
      "path": "../effect-sql-schema"
    },
    {
      "path": "../effect-zero"
    },
    {
      "path": "../effect-zero-workflow"
    },
    {
      "path": "../sheet-domain"
    },
    {
      "path": "../sheet-zero-api"
    },
    {
      "path": "../typhoon-zero"
    },
    {
      "path": "../tooling-config"
    }
  ]
}
