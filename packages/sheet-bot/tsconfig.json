{
  "extends": "../../tsconfig.browser.json",
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules", "dist", ".output", ".ts-out"],
  "compilerOptions": {
    "outDir": "./.ts-out",
    "rootDir": ".",
    "tsBuildInfoFile": "./.ts-out/.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "*": ["./*"],
      "~~/*": ["./*"],
      "@@/*": ["./*"],
      "~/*": ["./src/*"],
      "@/*": ["./src/*"],
      "dfx-discord-utils": ["../dfx-discord-utils/src/index.ts"],
      "dfx-discord-utils/*": ["../dfx-discord-utils/src/*"],
      "sheet-auth": ["../sheet-auth/src/index.ts"],
      "sheet-auth/identity/server": ["../sheet-auth/src/identity-server.ts"],
      "sheet-auth/*": ["../sheet-auth/src/*"],
      "sheet-bot-api": ["../sheet-bot-api/src/index.ts"],
      "sheet-bot-api/*": ["../sheet-bot-api/src/*"],
      "sheet-ingress-api": ["../sheet-ingress-api/src/index.ts"],
      "sheet-ingress-api/*": ["../sheet-ingress-api/src/*"],
      "sheet-workflow-contracts": ["../sheet-workflow-contracts/src/index.ts"],
      "sheet-workflow-contracts/*": ["../sheet-workflow-contracts/src/*"],
      "sheet-workflow-http-client": ["../sheet-workflow-http-client/src/index.ts"],
      "sheet-workflow-http-client/*": ["../sheet-workflow-http-client/src/*"],
      "sheet-zero-api": ["../sheet-zero-api/src/index.ts"],
      "sheet-zero-api/*": ["../sheet-zero-api/src/*"],
      "typhoon-core": ["../typhoon-core/src/index.ts"],
      "typhoon-core/*": ["../typhoon-core/src/*"],
      "typhoon-zero": ["../typhoon-zero/src/index.ts"],
      "typhoon-zero/*": ["../typhoon-zero/src/*"]
    }
  },
  "references": [
    {
      "path": "../dfx-discord-utils"
    },
    {
      "path": "../sheet-auth"
    },
    {
      "path": "../sheet-bot-api"
    },
    {
      "path": "../sheet-ingress-api"
    },
    {
      "path": "../sheet-workflow-contracts"
    },
    {
      "path": "../sheet-workflow-http-client"
    },
    {
      "path": "../sheet-zero-api"
    },
    {
      "path": "../typhoon-core"
    },
    {
      "path": "../typhoon-zero"
    },
    {
      "path": "../tooling-config"
    }
  ]
}
